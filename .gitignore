node_modules
out/
dist/
release/
*.log
.DS_Store
.vite/
.env
.env.local

# TypeScript incremental build state, not source.
*.tsbuildinfo

# Stray backup files left by patch tools.
*.orig

# graphify's generated knowledge graph: regenerated by `graphify update .`,
# and graph.json alone can run to tens of thousands of lines — committing it
# would put a multi-megabyte generated artifact in front of every diff and
# every reviewer. Keep it locally, never in git.
graphify-out/

# Local Claude Code configuration and scratch, never source: settings.json
# accumulates machine-specific permission grants with absolute home paths in
# them, and worktrees under here are local working state whose commit would
# put the whole tree in the repo a second time.
.claude/
.superpowers/

# M119. The ACP recordings under scripts/fixtures are FIXTURES a suite reads, not logs:
# the blanket *.log above hid them from git for one whole milestone.
!scripts/fixtures/agent-session/acp/*.log

# Evidence a committed doc CITES, kept OUT of out/ on purpose. The v9 run's
# ledger and its five act build-logs cite 84 paths under evidence/v9-run/;
# those files used to live in out/v9-evidence/, which is a build directory —
# `rm -rf out` is the normal reflex when a build goes strange, and it silently
# took the evidence for a whole run's ledger with it. Moved here so a build
# clean cannot reach it.
#
# Still ignored rather than committed, for the reason graphify-out/ is: 15MB of
# run logs in front of every diff and every reviewer is worse than a path that
# is machine-local, and the ledger's value is the SENTENCE it records, with the
# log as the thing that was read to write it.
evidence/

# Playwright MCP browser snapshots — scratch output, never source.
.playwright-mcp/
