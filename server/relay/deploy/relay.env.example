# /etc/tc-relay/relay.env — mode 0640, owner root:tc-relay.
TC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
TC_SUPABASE_ANON_KEY=
# Only for a project still signing with the legacy shared secret:
# TC_RELAY_JWT_SECRET=
# Supabase user ids (auth.users.id) allowed to START sessions — anyone else can
# only attach to a session shared into a workspace they belong to. Empty: nobody.
TC_RELAY_SPAWNERS=
TC_RELAY_PORT=7681
TC_RELAY_ADDRESS=127.0.0.1
TC_RELAY_PROGRAMS=/etc/tc-relay/programs.json
TC_RELAY_AUDIT=/var/log/tc-relay/audit.jsonl
