# One backup of every room (with its snapshots) into /var/backups/tc-collab,
# keeping the newest 14 — run by tc-collab-backup.timer. A failure exits 1,
# logs `backup.failed` and posts TC_ALERT_WEBHOOK (backup-main.ts).
[Unit]
Description=Terminal Canvas collab backup
After=network-online.target

[Service]
Type=oneshot
User=tc-collab
Group=tc-collab
EnvironmentFile=/etc/tc-collab/collab.env
ExecStart=/usr/bin/node /opt/tc-collab/backup.cjs dump /var/backups/tc-collab --keep 14
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/tc-collab
