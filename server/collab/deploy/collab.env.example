# /etc/tc-collab/collab.env — 0640 root:tc-collab. The collab server's settings
# (server/collab/main.ts documents each). Restart after editing:
#   sudo systemctl restart tc-collab
TC_SUPABASE_URL=https://<project>.supabase.co
TC_SUPABASE_ANON_KEY=<the project's anon key — the same one the app ships>
TC_COLLAB_PORT=1234
TC_COLLAB_ADDRESS=127.0.0.1
# The ONE secret here: a connection string for the `collab` schema
# (supabase/migrations/20260926120000_collab_documents.sql). Prefer a role of
# its own (docs/collab.md). Empty = rooms live in memory only.
TC_COLLAB_DATABASE_URL=
TC_COLLAB_SNAPSHOT_MINUTES=60
# Where alerts go (health and backup): a Slack/Discord/ntfy webhook URL. Empty = logged only.
TC_ALERT_WEBHOOK=
